{
	"root": "libs/verdaccio-quarantine-plugin",
	"targets": {
		"test": {
			"executor": "@nx/jest:jest",
			"options": {}
		},
		"build": {
			"executor": "@nx/js:tsc",
			"options": {
				"outputPath": "dist/libs/verdaccio-quarantine-plugin",
				"main": "libs/verdaccio-quarantine-plugin/src/index.ts",
				"tsConfig": "libs/verdaccio-quarantine-plugin/tsconfig.lib.json",
				"assets": [
					{
						"input": "libs/verdaccio-quarantine-plugin",
						"glob": "package.json",
						"output": "."
					}
				],
				"additionalEntryPoints": [
					"libs/verdaccio-quarantine-plugin/src/scanner.ts"
				]
			}
		},
		"build-scanner": {
			"executor": "@nx/js:tsc",
			"options": {
				"outputPath": "dist/libs/verdaccio-quarantine-plugin",
				"main": "libs/verdaccio-quarantine-plugin/src/scanner.ts",
				"tsConfig": "libs/verdaccio-quarantine-plugin/tsconfig.lib.json",
				"assets": []
			}
		},
		"post-build": {
			"executor": "nx:run-commands",
			"options": {
				"command": "chmod +x dist/libs/verdaccio-quarantine-plugin/scanner.js"
			},
			"dependsOn": ["build"]
		},
		"dev": {
			"executor": "nx:run-commands",
			"options": {
				"commands": ["chmod +x scripts/dev.sh && ./scripts/dev.sh"],
				"parallel": false
			}
		},
		"dev-rebuild": {
			"executor": "nx:run-commands",
			"options": {
				"commands": ["chmod +x scripts/dev.sh && ./scripts/dev.sh --rebuild"],
				"parallel": false
			}
		},
		"dev-stack": {
			"executor": "nx:run-commands",
			"options": {
				"commands": ["docker-compose up"],
				"parallel": false
			}
		}
	}
}
